[Desktop Entry]
Name=Dukiwi Shield
Comment=Antivirus, protection et vérification d'intégrité pour Linux
Comment[fr]=Antivirus, protection et vérification d'intégrité pour Linux
Comment[en]=Antivirus, protection and integrity checking for Linux
Exec=/opt/dukiwi-shield/dukiwi-shield.py
Icon=/opt/dukiwi-shield/icons/logo.svg
Terminal=false
Type=Application
Categories=System;Security;
Keywords=antivirus;clamav;security;virus;scan;
StartupNotify=true
StartupWMClass=dukiwi-shield.py
X-GNOME-Autostart-enabled=true
