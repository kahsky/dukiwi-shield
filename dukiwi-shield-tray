#!/bin/sh
# Dukiwi Shield — starts the shield (tray) in a transient user service that is restarted automatically
# if it is killed (Restart=always). "Quit" (administrator) stops this service cleanly.
# Only one instance per session: if the service is already active, we exit; if the user manager (systemd --user)
# is not reachable yet just after login, we wait up to 20 s instead of starting the program
# outside the service (this is how two shields appeared after a reboot: one started by the system service
# before the session was ready, another by the desktop autostart).
# Test variables: DUKIWI_SHIELD_TRAY_UNIT (unit name), DUKIWI_SHIELD_TRAY_CMD (command).
UNIT="${DUKIWI_SHIELD_TRAY_UNIT:-dukiwi-shield-tray}"
CMD="${DUKIWI_SHIELD_TRAY_CMD:-/usr/bin/python3 /opt/dukiwi-shield/dukiwi-shield.py --tray}"
# Lock in a folder of this account only (a shared /tmp name could be taken by another account)
LOCKDIR="${XDG_RUNTIME_DIR:-$HOME/.cache}"; [ -d "$LOCKDIR" ] && [ -w "$LOCKDIR" ] || { LOCKDIR="$HOME/.cache"; mkdir -p "$LOCKDIR"; }
LOCK="$LOCKDIR/$UNIT.$(id -u).launch.lock"
if command -v systemd-run >/dev/null 2>&1 && [ -n "$XDG_RUNTIME_DIR" ]; then
    i=0
    while ! systemctl --user show-environment >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -ge 20 ] && exit 75      # user manager missing: we will retry (system service every 20 s)
        sleep 1
    done
    if systemctl --user is-active --quiet "$UNIT.service"; then
        exit 0
    fi
    systemctl --user reset-failed "$UNIT.service" >/dev/null 2>&1
    # flock: two simultaneous launchers (desktop + system service) create only one unit
    exec flock -n "$LOCK" systemd-run --user --quiet --unit="$UNIT" --collect \
        -p Restart=always -p RestartSec=1 -p KillMode=process \
        --description="Dukiwi Shield (tray)" /bin/sh -c "exec $CMD"
fi
# Without systemd --user: direct execution, locked (single instance)
exec flock -n "$LOCK" /bin/sh -c "exec $CMD"
