#!/usr/bin/env python3
"""
Dukiwi Shield — administrator unlock.

Started via pkexec (polkit asks for an administrator's password), this script
runs as root and tells the service that the original user (PKEXEC_UID)
is allowed, for a few minutes, to perform the restricted actions:
disable the firewall, open a port, enable SSH, change the settings in
family mode, install an update.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from dukiwi_shield_common import daemon_request  # noqa: E402

uid = os.environ.get("PKEXEC_UID")
if uid is None or not uid.isdigit():
    print("PKEXEC_UID absent : ce programme doit être lancé via pkexec.", file=sys.stderr)
    sys.exit(2)
resp = daemon_request("unlock", timeout=5, uid=int(uid))
if not resp.get("ok"):
    print(f"Déverrouillage refusé : {resp.get('error')}", file=sys.stderr)
    sys.exit(1)
# The session token goes to stdout, read only by the program that ran pkexec (the GUI); it is not broadcast
print(f"token={resp.get('token', '')}")
print(f"Session administrateur ouverte pour l'uid {uid} ({resp.get('ttl')} s).", file=sys.stderr)
