[Unit]
Description=Dukiwi Shield - service système (scans complets et mises à jour sans mot de passe)
Documentation=https://github.com/kahsky/dukiwi-shield
After=network.target
Wants=dukiwi-shield-update.timer

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/dukiwi-shield/dukiwi-shield-daemon.py
Restart=on-failure
RestartSec=5
# /run/dukiwi-shield (socket), /var/lib/dukiwi-shield (état, quarantaine), /var/log/dukiwi-shield
RuntimeDirectory=dukiwi-shield
RuntimeDirectoryMode=0755
StateDirectory=dukiwi-shield
StateDirectoryMode=0755
LogsDirectory=dukiwi-shield
LogsDirectoryMode=0755
UMask=0022
# Laisser au daemon le temps de sauvegarder la progression du scan pour la reprise
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
