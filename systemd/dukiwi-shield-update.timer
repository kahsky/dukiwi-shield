[Unit]
Description=Dukiwi Shield - mises à jour tous les jours à 07:00 et 5 minutes après le démarrage

[Timer]
# Every day at 07:00
OnCalendar=*-*-* 07:00:00
# ... and 5 minutes after each computer startup
OnBootSec=5min
# Catch up on a missed 07:00 run (computer switched off)
Persistent=true
Unit=dukiwi-shield-update.service

[Install]
WantedBy=timers.target
